[Unit]
Description=dicta voice dictation daemon
Documentation=https://github.com/matthewjhunter/dicta
After=graphical-session.target pipewire.service
Wants=pipewire.service

[Service]
# Type=simple because dictad does not yet call sd_notify(READY=1).
# When the daemon learns to signal readiness, switch to Type=notify so
# units ordered After= dictad don't race the socket coming up.
Type=simple
# Installed by `task install:user` into the user's ~/.local/bin. For a
# system-wide install, override via `systemctl --user edit` (or ship a
# variant of this unit pointing at /usr/local/bin/dictad).
ExecStart=%h/.local/bin/dictad
Restart=on-failure
RestartSec=3

# Hardening (§7.1, §8)
#
# This is the *user-systemd* posture. The directives below all work in
# Ubuntu 25.10's user systemd (257); the four kernel/cgroup/namespace
# protections that imply CapabilityBoundingSet drops are intentionally
# omitted because the user manager has no caps to drop and refuses the
# unit with status=218/CAPABILITIES.
#
# Removed for user-systemd compatibility (re-enable in any system-wide
# variant of this unit):
#   ProtectKernelTunables=true
#   ProtectKernelModules=true
#   ProtectControlGroups=true
#   RestrictNamespaces=true
#
# Kept (still enforced):
#
# MemoryDenyWriteExecute relies on dictad being pure Go (D13). Anything
# that introduces CGo, an embedded interpreter, or a JIT into the daemon
# breaks this flag and the hardening posture goes with it.
#
# ProtectHome=read-only + ReadWritePaths=%h/.local/share/dicta lets the
# audit writer create JSONL/WAV files (when --audit-enabled) while
# blocking writes anywhere else under $HOME.
#
# RestrictAddressFamilies allows AF_UNIX (control socket, ydotoold,
# PipeWire), AF_INET / AF_INET6 (Wyoming + OpenAI ASR, cleanup HTTP).
# AF_NETLINK and friends are not needed.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/dicta %t
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=default.target
